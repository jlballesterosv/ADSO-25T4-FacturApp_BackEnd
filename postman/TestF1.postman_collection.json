            "item": [
                {
                    "name": "Register",
                    "request": {
                        "url": {
                            "raw": "http://127.0.0.1:5000/api/v1/register",
                            "protocol": "http",
                            "host": [
                                "127",
                                "0",
                                "0",
                                "1"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "v1",
                                "register"
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "description": "NCFC: creates a user with role PENDING. An ADMIN must assign a role with Users > Assign Role.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n    \"email\": \"vendedor1@facturapp.com\",\r\n    \"password\": \"123456\",\r\n    \"name\": \"Vendedor Uno\"\r\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [],
                    "protocolProfileBehavior": {}
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// NCFC: save the access_token in the collection variable \"token\"",
                                    "const body = pm.response.json();",
                                    "if (body.access_token) {",
                                    "    pm.collectionVariables.set(\"token\", body.access_token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "url": {
                            "raw": "http://127.0.0.1:5000/api/v1/login",
                            "protocol": "http",
                            "host": [
                                "127",
                                "0",
                                "0",
                                "1"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "v1",
                                "login"
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "description": "NCFC: returns access_token; the test script saves it in the collection variable token.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n    \"email\": \"admin@facturapp.com\",\r\n    \"password\": \"123456\"\r\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [],
                    "protocolProfileBehavior": {}
                }
            ]
        },
